{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Test",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pytest", "-v"],
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "Lint",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "ruff", "check", "."],
      "problemMatcher": []
    },
    {
      "label": "Evaluate public questions",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["scripts/evaluate.py"],
      "problemMatcher": []
    }
  ]
}
